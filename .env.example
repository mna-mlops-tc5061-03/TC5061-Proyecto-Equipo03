# Servidor de MLflow que usan los comandos de make en la máquina (experimentos, registry, drift...)
MLFLOW_TRACKING_URI=http://127.0.0.1:5001

# Docker Compose (make sistema). Descomentar solo lo que se quiera cambiar
# Puertos en 127.0.0.1 de MLflow y de la API
# MLFLOW_PUERTO=5000
# API_PUERTO=8000
# Carpeta con mlflow.db y mlartifacts/ para usar un Registry existente (por defecto, un volumen)
# MLFLOW_DATOS=./mlflow_compose
