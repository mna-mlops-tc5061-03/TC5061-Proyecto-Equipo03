# Servidor de MLflow que usan los comandos de make en la máquina (experimentos, registry, drift...)
MLFLOW_TRACKING_URI=http://127.0.0.1:5001

# Docker Compose (make sistema). Descomentar solo lo que se quiera cambiar
# Puertos en 127.0.0.1 de MLflow y de la API. Con 5001, MLFLOW_TRACKING_URI apunta al MLflow del
# compose; si ese puerto ya lo usa otro MLflow, cambiar los dos
# MLFLOW_PUERTO=5001
# API_PUERTO=8000
# Modelos que sirve la API del compose, si no es el champion (URI del Registry o carpeta)
# MODELO_URI=models:/mibici-equipo03-p2-riesgo@challenger
# MODELO_URI_P1=models:/mibici-equipo03-p1-demanda@challenger
# Carpeta con mlflow.db y mlartifacts/ para usar un Registry existente (por defecto, un volumen)
# MLFLOW_DATOS=./mlflow_compose
